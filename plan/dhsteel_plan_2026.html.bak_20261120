      'ph17-sheet-20261116': { checked: true, date: '2026-11-16', memo: '2026-11-16 시트 신설 및 회차 세팅' },
      'ph17-fax-report-docx': { checked: true, date: '2026-11-16', memo: '2026-11-16_fax_outbound_list.docx 발행' }
    };

    const checkboxes = document.querySelectorAll('.task-item input[type="checkbox"]');
    checkboxes.forEach(cb => {
      const id = cb.id;
      const def = defaults[id] || {};
      const dateInput = document.getElementById(id + '-date');
      const memoInput = document.getElementById(id + '-memo');

      // 저장값 확인 (신규 PREFIX 우선, 과거 PREFIX_1ST 보조)
      let savedCheck = localStorage.getItem(PREFIX + id);
      if (savedCheck === null) savedCheck = localStorage.getItem(PREFIX_1ST + id);

      let savedDate = localStorage.getItem(PREFIX + id + '_date');
      if (savedDate === null) savedDate = localStorage.getItem(PREFIX_1ST + id + '_date');

      let savedMemo = localStorage.getItem(PREFIX + id + '_memo');
      if (savedMemo === null) savedMemo = localStorage.getItem(PREFIX_1ST + id + '_memo');

      const isChecked = def.checked ? true : (savedCheck !== null ? savedCheck === 'true' : false);
      const dateVal = def.date ? def.date : (savedDate !== null ? savedDate : '');
      const memoVal = def.memo ? def.memo : (savedMemo !== null ? savedMemo : '');

      cb.checked = isChecked;
      if (isChecked) cb.closest('.task-item').classList.add('completed');
      if (dateInput && dateVal) dateInput.value = dateVal;
      if (memoInput && memoVal) memoInput.value = memoVal;

      if (savedCheck === null && def.checked !== undefined) localStorage.setItem(PREFIX + id, isChecked);
      if (savedDate === null && dateVal) localStorage.setItem(PREFIX + id + '_date', dateVal);
      if (savedMemo === null && memoVal) localStorage.setItem(PREFIX + id + '_memo', memoVal);

      cb.addEventListener('change', () => {
        localStorage.setItem(PREFIX + id, cb.checked);
        localStorage.setItem(PREFIX_1ST + id, cb.checked);
        cb.closest('.task-item').classList.toggle('completed', cb.checked);
        if (cb.checked && dateInput && !dateInput.value) {
          const today = new Date().toISOString().split('T')[0];
          dateInput.value = today;
          localStorage.setItem(PREFIX + id + '_date', today);
        } else if (!cb.checked && dateInput) {
          dateInput.value = '';
          localStorage.removeItem(PREFIX + id + '_date');
        }
      });

      if (dateInput) {
        dateInput.addEventListener('change', () => {
          localStorage.setItem(PREFIX + id + '_date', dateInput.value);
        });
      }
      if (memoInput) {
        memoInput.addEventListener('input', () => {
          localStorage.setItem(PREFIX + id + '_memo', memoInput.value);
        });
      }
    });
  </script>
</body>
</html>
